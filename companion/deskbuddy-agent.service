[Unit]
Description=DeskBuddy Linux media companion
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/deskbuddy-agent
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=graphical-session.target
